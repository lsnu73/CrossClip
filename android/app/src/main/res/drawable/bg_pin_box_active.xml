<?xml version="1.0" encoding="utf-8"?>
<!-- 配对码格（当前格）：石墨黑边 + 2.5px 8% 外发光 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#FFFFFF" />
            <stroke android:width="2.5dp" android:color="#14101216" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="@color/text_primary" />
        </shape>
    </item>
</layer-list>
