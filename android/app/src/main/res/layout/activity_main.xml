<?xml version="1.0" encoding="utf-8"?>
<!--
  屏 1 · 设置（hub，栈底）—— 按《CrossClip-最终规范与AI提示词.md》§二 屏 1 复原。
  设计纪律：白底直铺、无卡片无阴影；一种强调色(墨绿) + 一种危险色 + 一种链接色(仅路径)。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface">

    <!-- ============ 导航栏（46dp）：根屏隐藏返回箭头，右侧「关于」 ============ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="设置"
            android:textSize="16.5sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_about"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:padding="6dp"
            android:text="关于"
            android:textSize="14sp"
            android:textColor="@color/text_2"
            android:background="?attr/selectableItemBackground" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="-20dp"
            android:layout_marginEnd="-20dp"
            android:background="@color/line_color" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="26dp">

            <!-- ============ 连接总览 hero：无卡片、无阴影，直接铺白底 ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="18dp">

                <TextView
                    android:id="@+id/tv_conn_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tag_connected"
                    android:paddingStart="9dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="4dp"
                    android:text="● 已连接"
                    android:textSize="11.5sp"
                    android:textColor="@color/accent"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/tv_device_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="未连接设备"
                    android:textSize="25sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:id="@+id/tv_device_ip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="monospace"
                    android:text="正在搜索局域网内的电脑…"
                    android:textSize="12.5sp"
                    android:textColor="@color/text_2" />

                <!-- 配对码块：灰底内联块；未连接时整块隐藏 -->
                <LinearLayout
                    android:id="@+id/code_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_inline_block"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="配对码"
                            android:textSize="11sp"
                            android:textColor="@color/text_3"
                            android:letterSpacing="0.06" />

                        <TextView
                            android:id="@+id/tv_pairing_code"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="monospace"
                            android:text="— — — —"
                            android:textSize="20sp"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:letterSpacing="0.14" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btn_disconnect"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="6dp"
                        android:text="断开连接"
                        android:textSize="13sp"
                        android:textColor="@color/text_2"
                        android:background="?attr/selectableItemBackground" />
                </LinearLayout>

                <!-- 未连接态：配对码块替换为通栏黑色实心主按钮 -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_connect_hero"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_btn_dark"
                    android:text="连接电脑"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:textColor="#FFFFFF"
                    android:stateListAnimator="@null"
                    android:visibility="gone" />

                <!-- 统计行：今日已同步 N 条 | 上次 N 前（数字等宽） -->
                <TextView
                    android:id="@+id/tv_stats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="monospace"
                    android:text="今日已同步 0 条"
                    android:textSize="12sp"
                    android:textColor="@color/text_3" />
            </LinearLayout>

            <!-- ============ 分组：同步 ============ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingTop="26dp"
                android:paddingBottom="8dp"
                android:text="同步"
                android:textSize="11.5sp"
                android:textColor="@color/text_3"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <!-- 自动互传模式 -->
            <LinearLayout
                android:id="@+id/row_auto_sync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="54dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="自动互传模式"
                            android:textSize="15sp"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/info_auto"
                            style="@style/InfoCircle"
                            android:layout_width="13dp"
                            android:layout_height="13dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_auto_sync_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="复制内容后秒级静默同步至电脑"
                        android:textSize="12.5sp"
                        android:textColor="@color/text_3" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_auto_sync"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/switch_thumb"
                    app:track="@drawable/switch_track"
                    android:background="@null"
                    android:switchMinWidth="44dp"
                    android:thumbOffset="0dp"
                    android:checked="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/ex_auto"
                style="@style/ExplainBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="开启后，手机复制的内容会立即静默同步到电脑，无需手动发送。日常跨设备办公建议开启；若在意隐私或流量，可关闭后改为手动发送。" />

            <View style="@style/RowDivider" />

            <!-- 自动搜索电脑 -->
            <LinearLayout
                android:id="@+id/row_auto_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="54dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="自动搜索电脑"
                            android:textSize="15sp"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/info_search"
                            style="@style/InfoCircle"
                            android:layout_width="13dp"
                            android:layout_height="13dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_auto_search_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="5 分钟后降频、15 分钟后停止，避免夜间空转耗电"
                        android:textSize="12.5sp"
                        android:textColor="@color/text_3" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_auto_search"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/switch_thumb"
                    app:track="@drawable/switch_track"
                    android:background="@null"
                    android:switchMinWidth="44dp"
                    android:thumbOffset="0dp"
                    android:checked="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/ex_search"
                style="@style/ExplainBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="在局域网内广播并探测电脑，找到后自动完成握手连接。关闭后耗电更低，需要同步时点「电脑配对」里的重新扫描即可。" />

            <View style="@style/RowDivider" />

            <!-- 手动发送（自动互传关闭时才出现，保留旧版手动模式能力） -->
            <LinearLayout
                android:id="@+id/row_manual_send"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="54dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="?attr/selectableItemBackground"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="手动发送当前剪贴板"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="关闭自动互传后，点击立即发送一次"
                        android:textSize="12.5sp"
                        android:textColor="@color/text_3" />
                </LinearLayout>

                <ImageView
                    style="@style/RowChevron"
                    android:layout_width="8dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_chevron"
                    android:contentDescription="手动发送" />
            </LinearLayout>

            <!-- ============ 分组：隐私与显示 ============ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingTop="26dp"
                android:paddingBottom="8dp"
                android:text="隐私与显示"
                android:textSize="11.5sp"
                android:textColor="@color/text_3"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <!-- 最近任务隐藏 -->
            <LinearLayout
                android:id="@+id/row_hide_recents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="54dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="最近任务隐藏"
                            android:textSize="15sp"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/info_hide"
                            style="@style/InfoCircle"
                            android:layout_width="13dp"
                            android:layout_height="13dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="防误关：在多任务界面隐藏本应用卡片"
                        android:textSize="12.5sp"
                        android:textColor="@color/text_3" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_hide_recents"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/switch_thumb"
                    app:track="@drawable/switch_track"
                    android:background="@null"
                    android:switchMinWidth="44dp"
                    android:thumbOffset="0dp"
                    android:checked="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/ex_hide"
                style="@style/ExplainBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="在多任务视图中隐身，彻底免疫一键清理误杀，应用仍在后台正常同步。建议开启。" />

            <View style="@style/RowDivider" />

            <!-- 多任务卡片加锁：无开关，跳系统指引 -->
            <LinearLayout
                android:id="@+id/row_lock_task"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="54dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="多任务卡片加锁"
                            android:textSize="15sp"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/info_lock"
                            style="@style/InfoCircle"
                            android:layout_width="13dp"
                            android:layout_height="13dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="锁定应用卡片，避免被系统回收"
                        android:textSize="12.5sp"
                        android:textColor="@color/text_3" />
                </LinearLayout>

                <TextView
                    style="@style/GoText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="去设置" />

                <ImageView
                    style="@style/RowChevron"
                    android:layout_width="8dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_chevron"
                    android:contentDescription="多任务卡片加锁" />
            </LinearLayout>

            <TextView
                android:id="@+id/ex_lock"
                style="@style/ExplainBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="在多任务界面下拉或长按卡片加锁，免疫一键清理误杀。需跳转系统操作，频繁断连的用户建议开启。" />

            <View style="@style/RowDivider" />

            <!-- 通知权限 -->
            <LinearLayout
                android:id="@+id/row_notification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="54dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="通知权限"
                            android:textSize="15sp"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/info_notice"
                            style="@style/InfoCircle"
                            android:layout_width="13dp"
                            android:layout_height="13dp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_notification_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="检查中"
                    android:textSize="13.5sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_3" />

                <ImageView
                    style="@style/RowChevron"
                    android:layout_width="8dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_chevron"
                    android:contentDescription="通知权限" />
            </LinearLayout>

            <TextView
                android:id="@+id/ex_notice"
                style="@style/ExplainBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="开启后才能看到文件收发的进度通知。关闭后同步仍正常运行，只是不在通知栏展示。" />

            <!-- ============ 分组：存储 ============ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingTop="26dp"
                android:paddingBottom="8dp"
                android:text="存储"
                android:textSize="11.5sp"
                android:textColor="@color/text_3"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <!-- 接收文件保存目录 -->
            <LinearLayout
                android:id="@+id/row_save_dir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="54dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="接收文件保存目录"
                            android:textSize="15sp"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/info_dir"
                            style="@style/InfoCircle"
                            android:layout_width="13dp"
                            android:layout_height="13dp" />
                    </LinearLayout>

                    <!-- 蓝色可点路径：点击=用其他应用打开；长按=重新选择打开方式 -->

                    <TextView
                        android:id="@+id/tv_save_dir_path"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="2dp"
                        android:text="/storage/emulated/0/Download/CrossClip/"
                        android:textColor="@color/link_blue"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/tv_reset_save_dir"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:paddingTop="2dp"
                        android:text="恢复默认保存目录"
                        android:textSize="12sp"
                        android:textColor="@color/text_2"
                        android:visibility="gone"
                        android:background="?attr/selectableItemBackground" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_change_dir"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="6dp"
                    android:text="更改"
                    android:textSize="13sp"
                    android:textColor="@color/text_2"
                    android:background="?attr/selectableItemBackground" />
            </LinearLayout>

            <TextView
                android:id="@+id/ex_dir"
                style="@style/ExplainBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="电脑发来的文件会写入此目录。点击路径可用其他应用打开该目录，长按路径可重新选择打开方式。" />

            <View style="@style/RowDivider" />

            <!-- 本地缓存 -->
            <LinearLayout
                android:id="@+id/row_cache"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="54dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="本地缓存"
                            android:textSize="15sp"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/info_cache"
                            style="@style/InfoCircle"
                            android:layout_width="13dp"
                            android:layout_height="13dp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_cache_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="计算中"
                    android:textSize="13.5sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_3" />

                <TextView
                    android:id="@+id/btn_clear_cache"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="6dp"
                    android:text="清除"
                    android:textSize="13sp"
                    android:textColor="@color/text_2"
                    android:background="?attr/selectableItemBackground" />
            </LinearLayout>

            <TextView
                android:id="@+id/ex_cache"
                style="@style/ExplainBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="临时存放文件传输的中转分块，断点残留会自动清理。清除不影响已保存的接收文件。" />

            <!-- ============ 分组：系统权限 ============ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingTop="26dp"
                android:paddingBottom="8dp"
                android:text="系统权限"
                android:textSize="11.5sp"
                android:textColor="@color/text_3"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <!-- Shizuku 系统特权 -->
            <LinearLayout
                android:id="@+id/row_shizuku"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="54dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Shizuku 系统特权"
                            android:textSize="15sp"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/info_shizuku"
                            style="@style/InfoCircle"
                            android:layout_width="13dp"
                            android:layout_height="13dp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_shizuku_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="检查中"
                    android:textSize="13.5sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_3" />
            </LinearLayout>

            <TextView
                android:id="@+id/ex_shizuku"
                style="@style/ExplainBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="底层剪贴板监听，实现 100% 后台静默互传（零弹窗、零焦点切换）。未激活时自动使用兼容模式，部分功能受限。" />

            <View style="@style/RowDivider" />

            <!-- 后台省电策略 -->
            <LinearLayout
                android:id="@+id/row_battery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="54dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="后台省电策略"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/info_battery"
                        style="@style/InfoCircle"
                        android:layout_width="13dp"
                        android:layout_height="13dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/GoText"
                    android:text="去设置" />

                <ImageView
                    style="@style/RowChevron"
                    android:layout_width="8dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_chevron"
                    android:contentDescription="后台省电策略" />
            </LinearLayout>

            <TextView
                android:id="@+id/ex_battery"
                style="@style/ExplainBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="需设为无限制，防止被系统休眠误杀。若同步经常延迟或中断，建议前往调整。" />

            <View style="@style/RowDivider" />

            <!-- 自启动与后台复活 -->
            <LinearLayout
                android:id="@+id/row_autostart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="54dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="自启动与后台复活"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/info_autostart"
                        style="@style/InfoCircle"
                        android:layout_width="13dp"
                        android:layout_height="13dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/GoText"
                    android:text="去设置" />

                <ImageView
                    style="@style/RowChevron"
                    android:layout_width="8dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_chevron"
                    android:contentDescription="自启动与后台复活" />
            </LinearLayout>

            <TextView
                android:id="@+id/ex_autostart"
                style="@style/ExplainBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="需在系统安全中心允许自启，防止后台被杀后无法自动复活。希望长期免维护运行建议开启。" />

            <!-- ============ 诊断入口（居中下划线） + 页脚 ============ -->
            <TextView
                android:id="@+id/tv_diag_entry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="30dp"
                android:paddingBottom="4dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="查看诊断日志与排查工具"
                android:textSize="13.5sp"
                android:textColor="@color/text_2"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/tv_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="18dp"
                android:paddingBottom="8dp"
                android:fontFamily="monospace"
                android:text="CrossClip"
                android:textSize="11sp"
                android:textColor="@color/footer_text"
                android:letterSpacing="0.03" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
