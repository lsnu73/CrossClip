<?xml version="1.0" encoding="utf-8"?>
<!-- 屏 2 · 电脑配对：扫描态 / 已发现设备 / 手动添加 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface">

    <!-- 导航栏 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:paddingStart="12dp"
        android:paddingEnd="20dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_left"
            android:contentDescription="返回"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="电脑配对"
            android:textSize="16.5sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="-12dp"
            android:layout_marginEnd="-20dp"
            android:background="@color/line_color" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="26dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="20dp"
                android:paddingBottom="4dp"
                android:text="在同一局域网内打开 CrossClip 桌面端，选择下方设备并输入桌面端托盘显示的 6 位 PIN 码。"
                android:textSize="13.5sp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_2" />

            <!-- 搜索态：转圈 + 文案 + 超 10 秒引导 + 「停止搜索」。
                 配对页打开期间连续搜索（不降频、不超时），直到用户点停止或发现设备 -->
            <LinearLayout
                android:id="@+id/scan_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ProgressBar
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:indeterminateTint="@color/text_2"
                        android:indeterminate="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="正在搜索局域网内的电脑…"
                        android:textSize="13.5sp"
                        android:textColor="@color/text_2" />
                </LinearLayout>

                <!-- 搜索超过 10 秒仍未发现：引导用户点「停止搜索」自行排查 -->
                <TextView
                    android:id="@+id/tv_scan_overtime_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="3dp"
                    android:text="超过 10 秒仍未发现电脑？可点击下方「停止搜索」按钮"
                    android:textSize="12.5sp"
                    android:textColor="@color/text_3"
                    android:visibility="gone" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_stop_search"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="12dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:background="@drawable/bg_btn_ghost"
                    android:text="停止搜索"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:stateListAnimator="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />
            </LinearLayout>

            <!-- 停止态：用户点过「停止搜索」（或搜索被暂停）——给出排查指引与「开始搜索」 -->
            <LinearLayout
                android:id="@+id/empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingTop="22dp"
                android:paddingEnd="20dp"
                android:paddingBottom="6dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_empty_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="按下按钮搜索局域网内的电脑\n请确认电脑端 CrossClip 已启动，且手机与电脑在同一局域网"
                    android:textSize="13.5sp"
                    android:textColor="@color/text_3" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_start_search"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="12dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:background="@drawable/bg_btn_ghost"
                    android:text="开始搜索"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:stateListAnimator="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />
            </LinearLayout>

            <!-- 已发现的设备（扫描完成后显示） -->
            <LinearLayout
                android:id="@+id/device_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="4dp"
                    android:text="已发现的设备"
                    android:textSize="11.5sp"
                    android:textColor="@color/text_3"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <LinearLayout
                    android:id="@+id/device_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- 列表非空时搜索仍在后台持续（发现新设备会自动加入） -->
                <LinearLayout
                    android:id="@+id/searching_footer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="20dp"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:indeterminateTint="@color/text_3"
                        android:indeterminate="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="持续搜索中，发现新设备会自动加入"
                        android:textSize="12.5sp"
                        android:textColor="@color/text_3" />
                </LinearLayout>
            </LinearLayout>

            <!-- 手动添加 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingTop="26dp"
                android:paddingBottom="4dp"
                android:text="手动添加"
                android:textSize="11.5sp"
                android:textColor="@color/text_3"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <EditText
                android:id="@+id/et_manual_ip"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_input_field"
                android:hint="电脑 IP，如 192.168.1.100"
                android:inputType="textUri"
                android:maxLines="1"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_3"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="14dp"
                android:paddingEnd="20dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_add_ip"
                    style="@style/GhostButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:text="添加地址" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="18dp"
                android:paddingBottom="8dp"
                android:fontFamily="monospace"
                android:text="电脑端需保持 CrossClip 运行并放行防火墙"
                android:textSize="11sp"
                android:textColor="@color/footer_text"
                android:letterSpacing="0.03" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
